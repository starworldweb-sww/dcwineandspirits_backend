generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model hpwd_license {
  hpwd_license_id Int       @id @default(autoincrement())
  license_key     String    @db.VarChar(64)
  code            String    @db.VarChar(32)
  support_expiry  DateTime? @db.Date
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model oc_404s_report {
  link String   @db.VarChar(321)
  date DateTime @db.DateTime(0)

  @@ignore
}

model oc_address {
  address_id   Int    @id @default(autoincrement())
  customer_id  Int
  firstname    String @db.VarChar(32)
  lastname     String @db.VarChar(32)
  company      String @db.VarChar(40)
  address_1    String @db.VarChar(128)
  address_2    String @db.VarChar(128)
  city         String @db.VarChar(128)
  postcode     String @db.VarChar(10)
  country_id   Int    @default(0)
  zone_id      Int    @default(0)
  custom_field String @db.Text

  oc_country oc_country @relation(fields: [country_id], references: [country_id])
  oc_zone    oc_zone    @relation(fields: [zone_id], references: [zone_id])

  @@index([country_id], map: "country_id")
  @@index([customer_id], map: "customer_id")
  @@index([zone_id], map: "zone_id")
}

model oc_api {
  api_id        Int      @id @default(autoincrement())
  username      String   @db.VarChar(64)
  key           String   @db.Text
  status        Boolean
  date_added    DateTime @db.DateTime(0)
  date_modified DateTime @db.DateTime(0)
}

model oc_api_ip {
  api_ip_id Int    @id @default(autoincrement())
  api_id    Int
