  weight_class_id Int     @id @default(autoincrement())
  value           Decimal @default(0.00000000) @db.Decimal(15, 8)
}

model oc_weight_class_description {
  weight_class_id Int
  language_id     Int
  title           String @db.VarChar(32)
  unit            String @db.VarChar(4)

  @@id([weight_class_id, language_id])
}

model oc_zone {
  zone_id     Int          @id @default(autoincrement())
  country_id  Int
  name        String       @db.VarChar(128)
  code        String       @db.VarChar(32)
  status      Boolean      @default(true)
  ocAddresses oc_address[]

  @@index([country_id], map: "country_id")
}

model oc_zone_to_geo_zone {
  zone_to_geo_zone_id Int      @id @default(autoincrement())
  country_id          Int
  zone_id             Int      @default(0)
  geo_zone_id         Int
  date_added          DateTime @db.DateTime(0)
  date_modified       DateTime @db.DateTime(0)

  @@index([country_id], map: "country_id")
  @@index([geo_zone_id], map: "geo_zone_id")
  @@index([zone_id], map: "zone_id")
}

